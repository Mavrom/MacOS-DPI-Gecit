+
+// splitTLSRecord cuts the ClientHello into two TLS records in the middle of
+// the SNI hostname and sends each record as its own TCP segment. DPI boxes
+// that reassemble TCP but only parse the first TLS record never see the
+// whole hostname; TLS servers must accept handshake messages split across
+// records (RFC 8446 5.1), so the site itself is unaffected.
+func splitTLSRecord(raw []byte, msg *proto.TLSMessage) ([]Segment, bool) {
+	start, end, err := msg.ExtractSNIOffset()
+	if err != nil || end-start < 2 {
+		return nil, false
+	}
+	out, cut, ok := tlsRecordCut(raw, start+(end-start)/2)
+	if !ok {
+		return nil, false
+	}
+	return []Segment{{Packet: out[:cut]}, {Packet: out[cut:]}}, true
+}
+
+// tlsRecordCut rewrites a single TLS record so that its payload is carried in
+// two records, the first holding raw[5:at]. It returns the new bytes and the
+// offset where the second record starts.
+func tlsRecordCut(raw []byte, at int) ([]byte, int, bool) {
+	if len(raw) < 7 || raw[0] != 0x16 {
+		return nil, 0, false
+	}
+	n := int(raw[3])<<8 | int(raw[4])
+	end := 5 + n // anything after the first record is passed through as is
+	if end > len(raw) || at <= 5 || at >= end {
+		return nil, 0, false
+	}
+	first, second := at-5, n-(at-5)
+	out := make([]byte, 0, len(raw)+5)
+	out = append(out, raw[0], raw[1], raw[2], byte(first>>8), byte(first))
+	out = append(out, raw[5:at]...)
+	out = append(out, raw[0], raw[1], raw[2], byte(second>>8), byte(second))
+	out = append(out, raw[at:]...)
+	return out, at, true
+}
diff --git a/internal/desync/tlsrec_test.go b/internal/desync/tlsrec_test.go
new file mode 100644
index 0000000..2e56f4b
--- /dev/null
+++ b/internal/desync/tlsrec_test.go
@@ -0,0 +1,55 @@
+package desync
+
+import (
+	"bytes"
+	"testing"
+
+	"github.com/xvzc/spoofdpi/internal/config"
+	"github.com/xvzc/spoofdpi/internal/proto"
+)
+
+func TestSplitTLSRecord(t *testing.T) {
+	// FakeClientHello carries trailing bytes after its first record; keep
+	// the test to that record so lengths add up.
+	full := []byte(config.FakeClientHello)
+	raw := full[:5+(int(full[3])<<8|int(full[4]))]
+	msg, err := proto.ReadTLSMessage(bytes.NewReader(raw))
+	if err != nil {
+		t.Fatal(err)
+	}
+	segs, ok := splitTLSRecord(raw, msg)
+	if !ok || len(segs) != 2 {
+		t.Fatalf("split failed: ok=%v segs=%d", ok, len(segs))
+	}
+	out := append(append([]byte{}, segs[0].Packet...), segs[1].Packet...)
+	if len(out) != len(raw)+5 {
+		t.Fatalf("len %d, want %d", len(out), len(raw)+5)
+	}
+	// Both records keep the handshake type/version, and their payloads
+	// concatenate back to the original payload.
+	var payload []byte
+	for i, rec := range [][]byte{segs[0].Packet, segs[1].Packet} {
+		if !bytes.Equal(rec[:3], raw[:3]) {
+			t.Fatalf("record %d header %x", i, rec[:3])
+		}
+		n := int(rec[3])<<8 | int(rec[4])
+		if n != len(rec)-5 {
+			t.Fatalf("record %d length %d, body %d", i, n, len(rec)-5)
+		}
+		payload = append(payload, rec[5:]...)
+	}
+	if !bytes.Equal(payload, raw[5:]) {
+		t.Fatal("payload changed")
+	}
+	// The hostname must not be whole in the first record.
+	start, end, _ := msg.ExtractSNIOffset()
+	if bytes.Contains(segs[0].Packet, raw[start:end]) {
+		t.Fatal("first record carries the full SNI")
+	}
+}
+
+func TestTLSRecordCutRejectsNonHandshake(t *testing.T) {
+	if _, _, ok := tlsRecordCut([]byte{0x17, 3, 3, 0, 2, 1, 2}, 6); ok {
+		t.Fatal("accepted application data")
+	}
+}
